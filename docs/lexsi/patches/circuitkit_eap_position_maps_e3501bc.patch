+def collate_EAP_with_position_maps(xs, tokenizer, padding_side="left"):
+    """Collate paired EAP rows carrying explicit per-example position maps.
+
+    Each item is ``(clean, corrupted, label, (clean_positions, corrupt_positions))``.
+    Position arrays stay as per-row Python tuples so variable map lengths are not
+    padded or implicitly interpreted as token positions by PyTorch.
+    """
+    if padding_side not in {"left", "right"}:
+        raise ValueError("padding_side must be 'left' or 'right'")
+    if not xs or any(len(item) != 4 for item in xs):
+        raise ValueError("Every mapped EAP sample must contain clean, corrupted, label, and map")
+    clean, corrupted, labels, position_maps = zip(*xs)
+    def token_length(text):
+        ids = tokenizer(text, add_special_tokens=False)["input_ids"]
+        if ids and isinstance(ids[0], (list, tuple)):
+            ids = ids[0]
+        return len(ids)
+
+    clean_lengths = [token_length(text) for text in clean]
+    corrupt_lengths = [token_length(text) for text in corrupted]
+    sequence_length = max(max(clean_lengths), max(corrupt_lengths))
+    padded_maps = []
+    for (clean_pos, corrupt_pos), clean_len, corrupt_len in zip(
+        position_maps, clean_lengths, corrupt_lengths
+    ):
+        clean_offset = sequence_length - clean_len if padding_side == "left" else 0
+        corrupt_offset = sequence_length - corrupt_len if padding_side == "left" else 0
+        clean_padded = tuple(int(i) + clean_offset for i in clean_pos)
+        corrupt_padded = tuple(int(i) + corrupt_offset for i in corrupt_pos)
+        if any(i < 0 or i >= sequence_length for i in clean_padded + corrupt_padded):
+            raise ValueError("Padded position map is outside the joint sequence")
+        padded_maps.append((clean_padded, corrupt_padded))
+    return list(clean), list(corrupted), torch.tensor(labels), padded_maps
+
+
