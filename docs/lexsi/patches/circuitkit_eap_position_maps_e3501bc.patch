+def _map_corrupted_positions(activations: Tensor, position_maps):
+    """Gather each corrupted row into clean coordinates using explicit maps.
+
+    ``position_maps`` contains one ``(clean_positions, corrupted_positions)``
+    pair per row. Unmapped positions are zero and false in the returned mask.
+    The helper intentionally does not infer semantic correspondence.
+    """
+    if len(position_maps) != activations.shape[0]:
+        raise ValueError("position_maps must contain one map per batch row")
+    aligned = torch.zeros_like(activations)
+    valid = torch.zeros(activations.shape[:2], dtype=torch.bool, device=activations.device)
+    for row, pair in enumerate(position_maps):
+        if len(pair) != 2:
+            raise ValueError("Each position map must be (clean_positions, corrupted_positions)")
+        clean_pos = torch.as_tensor(pair[0], dtype=torch.long, device=activations.device)
+        corrupt_pos = torch.as_tensor(pair[1], dtype=torch.long, device=activations.device)
+        if clean_pos.ndim != 1 or corrupt_pos.ndim != 1 or clean_pos.numel() != corrupt_pos.numel():
+            raise ValueError("Mapped position arrays must be one-dimensional and equal length")
+        if clean_pos.numel() == 0:
+            raise ValueError("Each position map must contain at least one mapped position")
+        if torch.any(clean_pos < 0) or torch.any(clean_pos >= activations.shape[1]):
+            raise ValueError("Mapped clean position is out of bounds")
+        if torch.any(corrupt_pos < 0) or torch.any(corrupt_pos >= activations.shape[1]):
+            raise ValueError("Mapped corrupted position is out of bounds")
+        if clean_pos.unique().numel() != clean_pos.numel() or corrupt_pos.unique().numel() != corrupt_pos.numel():
+            raise ValueError("Position maps must be one-to-one")
+        aligned[row, clean_pos] = activations[row, corrupt_pos]
+        valid[row, clean_pos] = True
+    return aligned, valid
+
+
+def _build_eap_ig_input_endpoints(clean: Tensor, aligned_corrupted: Tensor, valid: Tensor):
+    """Use clean values at unmapped sites and mapped corrupt values elsewhere."""
+    if clean.shape != aligned_corrupted.shape or valid.shape != clean.shape[:2]:
+        raise ValueError("Clean, corrupted, and validity-mask shapes do not align")
+    mask = valid.reshape(*valid.shape, *([1] * (clean.ndim - 2)))
+    corrupted_endpoint = torch.where(mask, aligned_corrupted, clean)
+    return clean, corrupted_endpoint
+
